# ═══════════════════════════════════════════════════════════════
# AtmosForge — Serving Dockerfile (Minimal)
# Target: < 2GB final image
# CPU-only inference for production serving
# ═══════════════════════════════════════════════════════════════

FROM python:3.10-slim AS builder

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Install only inference dependencies (no CUDA, no training)
COPY pyproject.toml .

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir \
    fastapi>=0.110 \
    uvicorn[standard]>=0.27 \
    pydantic>=2.0 \
    numpy>=1.24 \
    mlflow>=2.11 \
    scipy>=1.12 \
    scikit-learn>=1.4 \
    python-dotenv>=1.0

# ─── Final Stage ─────────────────────────────────────────────
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy only serving-related code
COPY src/__init__.py ./src/
COPY src/models/ ./src/models/
COPY src/serving/ ./src/serving/
COPY src/training/trainer.py ./src/training/
COPY src/training/__init__.py ./src/training/
COPY src/utils/ ./src/utils/

# Create necessary directories
RUN mkdir -p mlruns mlartifacts checkpoints logs

# Health check
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Install curl for health check
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Non-root user
RUN useradd --create-home appuser
USER appuser

EXPOSE 8000

CMD ["uvicorn", "src.serving.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
