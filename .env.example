# ═══════════════════════════════════════════════════════════════
# AtmosForge — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Copernicus Climate Data Store (ERA5) ────────────────────
# Register at: https://cds.climate.copernicus.eu
CDS_API_KEY=your_copernicus_api_key_here

# ─── MLflow Experiment Tracking ─────────────────────────────
# Local: ./mlruns  |  Remote: http://mlflow-server:5000
MLFLOW_TRACKING_URI=./mlruns

# ─── FastAPI Inference Server ────────────────────────────────
# API key for authenticating prediction requests
API_KEY=your_inference_api_key_here

# ─── Reproducibility ────────────────────────────────────────
# Global random seed (propagated to all components)
SEED=42

# ─── GPU Configuration ──────────────────────────────────────
# CUDA device index (default: 0 for single GPU like RTX 4050)
CUDA_VISIBLE_DEVICES=0

# ─── Application Settings ───────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Data directory (relative or absolute path)
DATA_DIR=data
